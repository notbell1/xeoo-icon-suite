# ==============================================================================
# Xeoo Icon Theme - Environment Configuration Template
# ==============================================================================

# Environment Mode
NODE_ENV=production

# Extension Information
EXTENSION_NAME=xeoo-icon-theme
EXTENSION_DISPLAY_NAME=Xeoo Icon Theme
EXTENSION_PUBLISHER=NTTBELL
EXTENSION_VERSION=0.1.0

# Repository & Issue Tracker
GITHUB_REPOSITORY=https://github.com/notbell1/xeoo-icon-suite.git
GITHUB_HOMEPAGE=https://github.com/notbell1/xeoo-icon-suite
GITHUB_ISSUES=https://github.com/notbell1/xeoo-icon-suite/issues

# VS Code Marketplace Publishing Credentials
# Visual Studio Marketplace Personal Access Token (PAT)
VSCE_PAT=

# Open VSX Registry Token
OVSX_PAT=
